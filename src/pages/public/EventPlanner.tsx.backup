                                            src={prov.image} 
                                            alt={prov.title} 
                                            className="w-full sm:w-32 h-32 object-cover shrink-0"
                                        />
                                        <div className="p-4 flex flex-col justify-between">
                                            <div>
                                                <span className="text-[9px] font-bold text-blue-400 uppercase tracking-widest">{prov.category}</span>
                                                <h4 className="font-bold text-white text-xs mt-0.5 mb-1">{prov.title}</h4>
                                                <p className="text-[10px] text-slate-400 font-light leading-normal">{prov.desc}</p>
                                            </div>
                                            <div className="mt-3.5 pt-3.5 border-t border-slate-800/60 flex justify-end">
                                                <button
                                                    onClick={() => {
                                                        alert(`¡Excelente elección! Hemos registrado tu interés en "${prov.title}". Un asesor experto se contactará contigo por WhatsApp.`);
                                                    }}
                                                    className="bg-slate-950 hover:bg-slate-850 border border-slate-800 hover:border-slate-700 text-white font-bold text-[10px] px-3.5 py-2 rounded-lg transition-colors flex items-center gap-1"
                                                >
                                                    <MessageCircle size={10} className="text-green-400 shrink-0" />
                                                    {prov.actionLabel}
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>

                        </div>

                        <div className="p-6 border-t border-slate-800/80 bg-slate-900/30 flex gap-2">
                            <button
                                onClick={() => setIsRecommendationsOpen(false)}
                                className="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 rounded-xl text-xs transition-colors shadow-lg shadow-blue-500/10"
                            >
                                Entendido, Seguir Editando
                            </button>
                        </div>
                    </div>
                </div>
            )}

            {/* ----------------------------------------------------
                PREMIUM DRAWER MODAL
            ---------------------------------------------------- */}
            {isPremiumDrawerOpen && (
                <div className="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 flex items-center justify-center p-4 animate-fade-in">
                    <div className="bg-slate-950 border border-slate-800 w-full max-w-xl rounded-3xl shadow-2xl flex flex-col overflow-hidden relative">
                        <div className="absolute top-0 right-0 p-5 z-10">
                            <button 
                                onClick={() => setIsPremiumDrawerOpen(false)}
                                className="p-2 hover:bg-slate-900 rounded-full text-slate-500 hover:text-white transition-colors"
                            >
                                <X size={18} />
                            </button>
                        </div>

                        {/* Top banner */}
                        <div className="bg-gradient-to-tr from-amber-600 via-yellow-500 to-amber-500 p-8 text-slate-950 relative overflow-hidden">
                            <div className="absolute -bottom-8 -right-8 w-28 h-28 bg-white/10 rounded-full blur-2xl" />
                            <Crown size={36} className="text-slate-950 fill-slate-950 mb-3" />
                            <h3 className="text-2xl font-black tracking-tight text-slate-950">Tu Evento Organizado Digitalmente</h3>
                            <p className="text-xs text-slate-950/80 font-medium mt-1">Lleva tu fiesta al siguiente nivel sin complicaciones técnicas.</p>
                        </div>

                        {/* Comparatives */}
                        <div className="p-8 space-y-6">
                            
                            <div className="grid grid-cols-2 gap-4">
                                <div className="p-4 bg-slate-900 border border-slate-800 rounded-2xl">
                                    <h4 className="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">PLAN FREE</h4>
                                    <ul className="space-y-2 text-xs">
                                        <li className="flex items-center gap-1.5 text-slate-300">✅ Organizador de Invitados</li>
                                        <li className="flex items-center gap-1.5 text-slate-300">✅ Distribución de Mesas</li>
                                        <li className="flex items-center gap-1.5 text-slate-300">✅ Nube Básica (LocalStorage)</li>
                                        <li className="flex items-center gap-1.5 text-slate-300">✅ Importación / Exportación Excel</li>
                                        <li className="flex items-center gap-1.5 text-slate-300">✅ Recomendaciones y Consejos</li>
                                        <li className="flex items-center gap-1.5 text-slate-650 line-through">❌ Invitaciones Digitales</li>
                                        <li className="flex items-center gap-1.5 text-slate-650 line-through">❌ RSVP Automático y SMS</li>
                                    </ul>
                                </div>

                                <div className="p-4 bg-blue-950/20 border border-blue-500/20 rounded-2xl relative">
                                    <span className="absolute top-2.5 right-2.5 bg-blue-500 text-white font-extrabold text-[7px] px-1.5 py-0.5 rounded-full uppercase tracking-wider">Recomendado</span>
                                    <h4 className="text-xs font-bold text-blue-400 uppercase tracking-widest mb-3">PLAN PREMIUM</h4>
                                    <ul className="space-y-2 text-xs">
                                        <li className="flex items-center gap-1.5 text-white font-semibold">🌟 Todo lo del Plan Free</li>
                                        <li className="flex items-center gap-1.5 text-white font-semibold">🌟 Nube Completa Multidispositivo</li>
                                        <li className="flex items-center gap-1.5 text-white font-semibold">🌟 Invitaciones Digitales VIP</li>
                                        <li className="flex items-center gap-1.5 text-white font-semibold">🌟 Confirmaciones (RSVP) en Vivo</li>
                                        <li className="flex items-center gap-1.5 text-white font-semibold">🌟 Control QR y Recepcionista</li>
                                        <li className="flex items-center gap-1.5 text-white font-semibold">🌟 Soporte 24/7 de EventPix</li>
                                        <li className="flex items-center gap-1.5 text-white font-semibold">🌟 Backup Total Permanente</li>
                                    </ul>
                                </div>
                            </div>

                            <div className="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex justify-between items-center">
                                <div>
                                    <p className="text-xs font-bold text-white">Pago Único por Evento</p>
                                    <p className="text-[10px] text-slate-500 font-semibold mt-0.5">Olvídate de suscripciones mensuales confusas.</p>
                                </div>
                                <div className="text-right">
                                    <span className="text-xl font-black text-amber-400 tracking-tight">$14.999 ARS</span>
                                    <span className="block text-[8px] text-slate-500 uppercase tracking-wider font-bold">Un solo pago</span>
                                </div>
                            </div>

                        </div>

                        {/* Footer Checkout action */}
                        <div className="p-8 border-t border-slate-850 bg-slate-950 flex gap-2">
                            <button
                                onClick={() => setIsPremiumDrawerOpen(false)}
                                className="flex-1 bg-slate-900 hover:bg-slate-850 text-white font-bold py-3.5 rounded-2xl text-xs transition-colors"
                            >
                                Seguir con Plan Free
                            </button>
                            <button
                                onClick={() => {
                                    alert('¡Felicidades! Iniciando pasarela de pago EventPix VIP para tu evento. Podrás personalizar tus invitaciones web de inmediato.');
                                    setIsPremiumDrawerOpen(false);
                                }}
                                className="flex-1 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-750 text-slate-950 font-black py-3.5 rounded-2xl text-xs transition-all shadow-xl shadow-amber-500/15"
                            >
                                Adquirir Premium VIP
                            </button>
                        </div>
                    </div>
                </div>
            )}

            {/* Footer rights branding */}
            <footer className="bg-slate-950 border-t border-slate-900/60 py-6 px-6 text-center text-[10px] text-slate-600 font-medium uppercase tracking-widest">
                &copy; {new Date().getFullYear()} EventPix Planner • Desarrollado por Tecno Eventos. Todos los derechos reservados.
            </footer>

        </div>
    );
}

// ----------------------------------------------------
// CANVAS MODULE COMPONENT: Room table with chairs
// ----------------------------------------------------
interface CanvasTableGroupProps {
    table: PlannerTable;
    isSelected: boolean;
    onSelect: () => void;
    onChange: (attrs: any) => void;
    assignedGuests: PlannerGuest[];
}

function CanvasTableGroup({ table, isSelected, onSelect, onChange, assignedGuests }: CanvasTableGroupProps) {
    const groupRef = useRef<any>(null);
    const trRef = useRef<any>(null);

    useEffect(() => {
        if (isSelected && trRef.current && groupRef.current) {
            trRef.current.nodes([groupRef.current]);
            trRef.current.getLayer().batchDraw();
        }
    }, [isSelected]);

    const chairsCount = table.capacity || getUpdatedChairs(table.type, { radius: table.radius || 0, width: table.width || 0, height: table.height || 0 });
    
    // Distribute chairs visual seats on canvas dynamically
    const chairs = useMemo(() => {
        const c = [];
        if (table.type === 'round') {
            const rad = table.radius || 75;
            for (let i = 0; i < chairsCount; i++) {
                const angle = (i * 2 * Math.PI) / chairsCount;
                const chairX = (rad + 20) * Math.cos(angle);
                const chairY = (rad + 20) * Math.sin(angle);
                c.push({ x: chairX, y: chairY, occupied: i < assignedGuests.length });
            }
        } else {
            const w = table.width || 200;
            const h = table.height || 100;
            const count = chairsCount;
            const perimeter = 2 * (w + h);
            let dist = 0;
            const step = perimeter / count;
            
            for (let i = 0; i < count; i++) {
                let x = 0, y = 0;
                let d = dist;
                if (d < w) {
                    x = -w / 2 + d; y = -h / 2 - 20;
                } else if (d < w + h) {
                    x = w / 2 + 20; y = -h / 2 + (d - w);
                } else if (d < 2 * w + h) {
                    x = w / 2 - (d - (w + h)); y = h / 2 + 20;
                } else {
                    x = -w / 2 - 20; y = h / 2 - (d - (2 * w + h));
                }
                c.push({ x, y, occupied: i < assignedGuests.length });
                dist += step;
            }
        }
        return c;
    }, [table.width, table.height, table.radius, table.type, chairsCount, assignedGuests.length]);

    return (
        <>
            <Group
                ref={groupRef}
                x={table.x}
                y={table.y}
                rotation={table.rotation}
                draggable
                onClick={(e) => { e.cancelBubble = true; onSelect(); }}
                onTap={(e) => { e.cancelBubble = true; onSelect(); }}
                onDragEnd={(e) => {
                    e.cancelBubble = true;
                    const node = groupRef.current;
                    if (node) {
                        onChange({ x: Math.round(node.x()), y: Math.round(node.y()) });
                    }
                }}
                onTransformEnd={(e) => {
                    e.cancelBubble = true;
                    const node = groupRef.current;
                    const scaleX = node.scaleX();
                    const scaleY = node.scaleY();
                    
                    node.scaleX(1);
                    node.scaleY(1);

                    if (table.type === 'round') {
                        const newRad = Math.max(30, Math.round((table.radius || 75) * scaleX));
                        onChange({
                            x: Math.round(node.x()),
                            y: Math.round(node.y()),
                            radius: newRad,
                            capacity: getUpdatedChairs('round', { radius: newRad, width: 0, height: 0 })
                        });
                    } else {
                        const newW = Math.max(50, Math.round((table.width || 200) * scaleX));
                        const newH = Math.max(40, Math.round((table.height || 100) * scaleY));
                        onChange({
                            x: Math.round(node.x()),
                            y: Math.round(node.y()),
                            width: newW,
                            height: newH,
                            capacity: getUpdatedChairs('rect', { radius: 0, width: newW, height: newH })
                        });
                    }
                }}
            >
                {/* Chairs */}
                {chairs.map((c, i) => (
                    <Circle 
                        key={i}
                        x={c.x}
                        y={c.y}
                        radius={10}
                        fill={c.occupied ? "#3b82f6" : "#1e293b"} // blue-500 when occupied
                        stroke={c.occupied ? "#2563eb" : "#475569"}
                        strokeWidth={1.5}
                        shadowBlur={2}
                        opacity={0.9}
                    />
                ))}

                {/* Table Solid Body */}
                {table.type === 'round' ? (
                    <Circle 
                        radius={table.radius || 75}
                        fill={isSelected ? '#1e293b' : '#0f172a'}
                        stroke={isSelected ? '#3b82f6' : '#334155'}
                        strokeWidth={isSelected ? 3 : 1.5}
                        shadowColor="black"
                        shadowBlur={10}
                        shadowOpacity={0.25}
                    />
                ) : (
                    <Rect 
                        x={-(table.width || 200) / 2}
                        y={-(table.height || 100) / 2}
                        width={table.width || 200}
                        height={table.height || 100}
                        fill={isSelected ? '#1e293b' : '#0f172a'}
                        stroke={isSelected ? '#3b82f6' : '#334155'}
                        strokeWidth={isSelected ? 3 : 1.5}
                        cornerRadius={6}
                        shadowColor="black"
                        shadowBlur={10}
                        shadowOpacity={0.25}
                    />
                )}

                {/* Label text */}
                <KonvaText 
                    text={`${table.label}\n(${assignedGuests.length}/${chairsCount})`}
                    fontSize={Math.max(10, Math.min(table.width || (table.radius || 75) * 1.5, 13))}
                    fontStyle="bold"
                    fontFamily="sans-serif"
                    align="center"
                    verticalAlign="middle"
                    width={table.type === 'round' ? (table.radius || 75) * 1.7 : table.width}
                    height={table.type === 'round' ? (table.radius || 75) * 1.7 : table.height}
                    x={table.type === 'round' ? -(table.radius || 75) * 0.85 : -(table.width || 200) / 2}
                    y={table.type === 'round' ? -(table.radius || 75) * 0.85 : -(table.height || 100) / 2}
                    fill={isSelected ? '#60a5fa' : '#94a3b8'}
                />

            </Group>

            {/* Transform outline frame */}
            {isSelected && (
                <Transformer 
                    ref={trRef}
                    boundBoxFunc={(oldBox, newBox) => {
                        if (newBox.width < 60 || newBox.height < 50) return oldBox;
                        return newBox;
                    }}
                    enabledAnchors={table.type === 'round' ? ['top-left', 'top-right', 'bottom-left', 'bottom-right'] : ['top-left', 'top-right', 'bottom-left', 'bottom-right', 'middle-left', 'middle-right', 'top-center', 'bottom-center']}
                />
            )}
        </>
    );
}
