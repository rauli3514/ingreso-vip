                    </form>
                </div>
            )}

            {/* ----------------------------------------------------
                RECOMMENDATIONS MODAL DRAWER
            ---------------------------------------------------- */}
            {isRecommendationsOpen && (
                <div className="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 flex justify-end">
                    <div className="fixed inset-0" onClick={() => setIsRecommendationsOpen(false)} />
                    <div className="bg-slate-950 border-l border-slate-800/80 w-full max-w-lg h-full flex flex-col relative z-10 animate-in slide-in duration-300 overflow-hidden shadow-2xl">
                        
